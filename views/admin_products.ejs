<%- include('./partials/header'); %>

    <body class="bg-gray-50">
        <div class="flex flex-col min-h-screen">
            <!-- Navigation Bar -->
            <nav class="bg-white border-b border-gray-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between h-16">
                        <!-- Left section -->
                        <div class="flex items-center space-x-8">
                            <a href="/" class="flex items-center">
                                <img src="/images/RAPIDGO.png" alt="Logo" class="h-8 w-auto">
                            </a>
                            <div class="hidden md:flex items-center space-x-6">
                                <a href="/admin/dashboard" class="text-gray-500 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
                                    Dashboard
                                </a>
                                <a href="/admin/products" class="bg-indigo-50 text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">
                                    Products
                                </a>
                                <a href="/admin/orders" class="text-gray-500 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
                                    Orders
                                </a>
                            </div>
                        </div>

                        <!-- Mobile menu button -->
                        <div class="md:hidden flex items-center">
                            <button type="button" class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
                                <span class="sr-only">Open main menu</span>
                                <i class="ri-menu-line text-xl"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile menu -->
                <div class="mobile-menu hidden md:hidden">
                    <div class="px-2 pt-2 pb-3 space-y-1">
                        <a href="/admin/dashboard" class="block px-3 py-2 rounded-md text-base font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50">
                            Dashboard
                        </a>
                        <a href="/admin/products" class="block px-3 py-2 rounded-md text-base font-medium bg-indigo-50 text-indigo-600">
                            Products
                        </a>
                        <a href="/admin/orders" class="block px-3 py-2 rounded-md text-base font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50">
                            Orders
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Header -->
            <header class="bg-white shadow-sm">
                <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                    <h1 class="text-2xl font-semibold text-gray-900">Product Management</h1>
                </div>
            </header>

            <!-- Main content -->
            <main class="flex-1 overflow-y-auto py-6">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <!-- Search Bar -->
                    <div class="mb-6">
                        <form action="/admin/products/search" method="GET" class="flex max-w-2xl mx-auto">
                            <input type="text" name="product_id" placeholder="Search by Product ID"
                                class="w-full p-3 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <button type="submit"
                                class="bg-indigo-600 text-white py-3 px-6 rounded-r-lg hover:bg-indigo-700 transition-colors duration-200">
                                Search
                            </button>
                        </form>
                    </div>

                    <!-- Product List by Category -->
                    <% for(let key in products){ %>
                        <div class="bg-white shadow-sm rounded-lg mb-6 p-6">
                            <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b pb-3">
                                <%= key %>
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            <% products[key].forEach(function(elem){ %>
                                <div class="bg-white p-5 rounded-lg border border-gray-100 hover:shadow-md transition-shadow duration-200">
                                    <div class="flex justify-center mb-4">
                                        <img class="w-36 h-36 object-contain rounded-lg"
                                            src="data:image/png;base64, <%= elem.image.toString('base64') %>" alt="<%= elem.name %>">
                                    </div>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">
                                        <%= elem.name %>
                                    </h3>
                                    <div class="space-y-2 text-gray-600">
                                        <p class="flex items-center">
                                            <span class="font-medium">Price:</span>
                                            <span class="ml-2">₹<%= elem.price %></span>
                                        </p>
                                        <p class="flex items-center">
                                            <span class="font-medium">Stock:</span>
                                            <span class="ml-2"><%= elem.stock %></span>
                                        </p>
                                        <p class="text-gray-700 line-clamp-2 text-sm">
                                            <%= elem.description %>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-2">
                                            Product ID: <%= elem._id %>
                                        </p>
                                    </div>
                                    <div class="mt-5 flex gap-4">
                                        <a href="/products/delete/<%= elem._id %>"
                                            class="text-red-600 hover:text-red-800 text-sm font-medium transition-colors duration-200">Delete</a>
                                        <a href="" class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors duration-200">Update</a>
                                    </div> 
                                </div>
                            <% }) %>
                            </div>
                            <div class="mt-5 text-center">
                                <a href="/admin/products?category=&page=2"
                                    class="inline-flex items-center text-indigo-600 hover:text-indigo-800 text-sm font-medium transition-colors duration-200">
                                    See More
                                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </main>
        </div>

        <script>
            // Mobile menu toggle
            const mobileMenuButton = document.querySelector('.mobile-menu-button');
            const mobileMenu = document.querySelector('.mobile-menu');

            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
                    mobileMenu.classList.add('hidden');
                }
            });
        </script>
    </body>

    <%- include('./partials/footer'); %>