<%- include('./partials/header'); %>

    <style>
        .swiper-container {
            width: 100%;
            max-width: 100%;
        }

        .swiper-slide {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height:60vh;
            background-color: #f0f0f0;
        }
        #random::-webkit-scrollbar{
            display: none;
        }
       @media (max-width: 768px) {
        .swiper-container{
            display: block !important;;
        }
        .products{
            display: grid;
            grid-column: 4 !important;
        }
       }
       
    </style>

    <body class="bg-gray-100 overflow-x-hidden font-sans">
        <div class="w-screen p-4">
            <div class=" flex items-center bg-white rounded mb-5 justify-between px-2 py-2">
                <div class="flex items-center justify-center gap-1">
                    <i class="ri-home-heart-fill  text-2xl"></i>
                    <h1 class=" text-xl font-medium">RapidGoods</h1>
                </div>
                <button class="px-6 py-2 bg-black text-white text-sm rounded cursor">Explore More</button>
           </div>
            <!-- Order Now Section -->
            <div class="bg-white p-4 rounded-lg shadow mb-4">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold">Order Now</h2>
                    <button class="text-blue-500">see all</button>
                </div> 
                <div id="random" class="flex space-x-4 mt-4 overflow-x-auto ">
                    <% randomProduct.forEach(function(elem){ %>
                    <div class="flex w-32 flex-shrink-0 flex-col items-center">
                        <div class="relative">
                            <img class="h-24 rounded" src="data:image/png;base64, <%= elem.image.toString('base64') %>" alt="<%= elem.name %>">
                        </div>

                        <p class="text-sm text-center mt-2">
                            <%= elem.name %>
                        </p>
                        <p class="text-xs text-gray-500 line-through">
                            ₹ <%= Number(elem.price) + Math.floor(Math.random()*100) %>
                        </p>
                        <p class="font-bold">
                            ₹ <%= elem.price %>
                        </p>
                        <a href="/cart/add/<%= elem._id %>" class="px-8 text-white text-sm rounded mt-2 inline-block py-1 bg-green-700" ><i class="ri-shopping-cart-line"></i></a>
                        
                    </div>
                     <% }) %>
                   
                </div>
            </div>

            <!-- Offers Section -->
            <div class="swiper-container hidden my-10 w-full overflow-hidden">
                <div class="swiper-wrapper">
                    
                    <div class="swiper-slide rounded-xl overflow-hidden">
                        <img class="h-full w-screen object-cover"
                            src="https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=70,metadata=none,w=720/layout-engine/2023-07/pharmacy-WEB.jpg"
                            alt="">
                    </div>
                    <div class="swiper-slide rounded-xl overflow-hidden">
                        <img class=" h-full w-screen object-cover"
                            src="https://cdn.grofers.com/cdn-cgi/image/f=auto,fit=scale-down,q=70,metadata=none,w=720/layout-engine/2023-07/Pet-Care_WEB.jpg"
                            alt="">
                    </div>
                </div>
            </div>



            <!-- Grocery & Kitchen Section -->
            <% for(let key in products){ %>
                <div class="bg-white p-4 rounded-lg shadow mb-10">
                    <h2 class="text-xl text-center bg-yellow-400 px-2 py-3 rounded font-semibold">
                        <%= key %>
                    </h2>
                    <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 mt-6">
                        <% products[key].forEach(function(elem){ %>
                            <div class="flex flex-col w-26 items-center flex-shrink-0" >
                                <img class="h-24 rounded" src="data:image/png;base64, <%= elem.image.toString('base64') %>" alt="<%= elem.name %>">
                                <div class="h-16 flex flex-col items-center">
                                    <p class=" text-center font-medium mt-2"> <%= elem.name %></p>
                                   <p class="font-semibold text-gray-800">
                                      ₹ <%= elem.price %>
                                   </p>
                                </div>
                               <a href="/cart/add/<%= elem._id %>" class="px-6 text-white text-xs rounded mt-2 inline-block py-2 bg-green-700" >ADD <i class="ri-shopping-cart-line"></i></a>
                            </div>
                        <% }); %>
                    </div>
                </div>
             <% } %>


                <!-- Footer -->
               <% if(somethingInCart){ %>
                <div class="py-20"></div>
                <div class="bg-white p-4 rounded-lg shadow fixed bottom-0 inset-x-0">
                    <div class="flex justify-between  bg-gray-50  py-2 px -4 items-center mb-5">
                        <div>
                            <p class="text-sm">Get FREE delivery</p>
                            <p class="text-xs text-gray-500">Add products worth ₹236 more</p>
                        </div>
                        <button class="text-blue-500">See all coupons</button>
                    </div>
                    <div class="flex flex-col">
                        <div>
                           <%= cartCount %> Item <i class="ri-shopping-cart-fill"></i></i> -
                        </div>
                        <a href="/cart"
                            class="flex items-center justify-center w-full py-3 bg-green-700 text-white rounded-lg">
                            <span class="text-lg">Next</span>
                            <i class="text-2xl ri-arrow-right-s-fill"></i>
                        </a>
                    </div>
                </div>
               <% } %>
                <!--  -->
        </div>

        <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
        <script>
            var swiper = new Swiper('.swiper-container', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: {
                    rotate: 10,
                    stretch: 0,
                    depth: 10,
                    modifier: 1,
                    slideShadows: true,
                },
                loop: true,
                autoplay: {
                    delay: 3000,
                    disableOnInteraction: false,
                },
            });
        </script>
        <script>
            // Save the scroll position to localStorage
            window.addEventListener('scroll', function () {
                localStorage.setItem('scrollPosition', window.scrollY);
            });

            // Restore the scroll position from localStorage
            window.addEventListener('load', function () {
                const scrollPosition = localStorage.getItem('scrollPosition');
                if (scrollPosition) {
                    window.scrollTo(0, scrollPosition);
                }
            });
        </script>
    </body>
<%- include('./partials/footer'); %>
