<%- include('./partials/header'); %>

    <body class="bg-gray-100">
        <div class="flex flex-col min-h-screen">
            <!-- Navigation Bar -->
            <nav class="bg-white border-b border-gray-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between h-16">
                        <!-- Left section -->
                        <div class="flex items-center space-x-8">
                            <a href="/" class="flex items-center">
                                <img src="/images/RAPIDGO.png" alt="Logo" class="h-8 w-auto">
                            </a>
                            <div class="hidden md:flex items-center space-x-6">
                                <a href="/admin/dashboard" class="bg-indigo-50 text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">
                                    Dashboard
                                </a>
                                <a href="/admin/products" class="text-gray-500 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
                                    Products
                                </a>
                                <a href="/admin/orders" class="text-gray-500 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200">
                                    Orders
                                </a>
                            </div>
                        </div>

                        <!-- Mobile menu button -->
                        <div class="md:hidden flex items-center">
                            <button type="button" class="mobile-menu-button inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
                                <span class="sr-only">Open main menu</span>
                                <i class="ri-menu-line text-xl"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile menu -->
                <div class="mobile-menu hidden md:hidden">
                    <div class="px-2 pt-2 pb-3 space-y-1">
                        <a href="/admin/dashboard" class="block px-3 py-2 rounded-md text-base font-medium bg-indigo-50 text-indigo-600">
                            Dashboard
                        </a>
                        <a href="/admin/products" class="block px-3 py-2 rounded-md text-base font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50">
                            Products
                        </a>
                        <a href="/admin/orders" class="block px-3 py-2 rounded-md text-base font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50">
                            Orders
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Header -->
            <header class="bg-white shadow">
                <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                    <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
                </div>
            </header> 

            <!-- Main content -->
            <main class="flex-1 overflow-y-auto">
                <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
                    <!-- Dashboard Overview -->
                    <div class="mb-8 bg-white shadow rounded-lg p-6">
                        <h2 class="text-2xl font-semibold text-gray-800">Dashboard Overview</h2>
                        <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h3 class="text-lg font-medium text-gray-600">Total Products</h3>
                                <p class="mt-2 text-2xl font-bold text-gray-900">
                                   <%= prodCount %>
                                </p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h3 class="text-lg font-medium text-gray-600">Total Categories</h3>
                                <p class="mt-2 text-2xl font-bold text-gray-900">
                                    <%= catCount %>
                                </p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h3 class="text-lg font-medium text-gray-600">New Orders</h3>
                                <p class="mt-2 text-2xl font-bold text-gray-900">30</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Create/Update Product Form -->
                        <div class="bg-white shadow rounded-lg p-6">
                            <h2 class="text-2xl font-semibold text-gray-800">Manage Products</h2>
                            <form enctype="multipart/form-data" autocomplete="off" class="mt-4" action="/products"
                                method="POST">
                                <h3 class="text-lg font-medium text-gray-700">Create Product</h3>
                                <div class="mt-2">
                                    <input type="text" name="name" placeholder="Product Name" required
                                        class="w-full p-2 border border-gray-300 rounded mt-2">
                                </div>
                                <div class="mt-2">
                                    <input type="number" name="price" placeholder="Product Price" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-2">
                                    <input type="text" name="category" placeholder="Category" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-2">
                                    <textarea name="description" placeholder="Product Description" rows="4"
                                        class="w-full p-2 border border-gray-300 rounded"></textarea>
                                </div>
                                <div class="mt-2">
                                    <input type="number" name="stock" placeholder="Stock Quantity" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-2">
                                    <input type="file" name="image" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-4">
                                    <button type="submit"
                                        class="w-full bg-black text-white py-2 px-4 rounded hover:bg-black">
                                        Create Product
                                    </button>
                                </div>
                            </form>

                            <!-- Delete Product Form -->
                            <form autocomplete="off" class="mt-6" action="/products/delete" method="POST">
                                <h3 class="text-lg font-medium text-gray-700">Delete Product</h3>
                                <div class="mt-2">
                                    <input type="text" name="product_id" placeholder="Product ID" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-4">
                                    <button type="submit"
                                        class="w-full bg-black text-white py-2 px-4 rounded hover:bg-black">
                                        Delete Product
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Create/Update Category Form -->
                        <div class="bg-white shadow rounded-lg p-6">
                            <h2 class="text-2xl font-semibold text-gray-800">Manage Categories</h2>
                            <form autocomplete="off" class="mt-4" action="/categories/create" method="POST">
                                <h3 class="text-lg font-medium text-gray-700">Create or Update Category</h3>
                                <div class="mt-2">
                                    <input type="text" name="name" placeholder="Category Name" required
                                        class="w-full p-2 border border-gray-300 rounded">
                                </div>
                                <div class="mt-4">
                                    <button type="submit"
                                        class="w-full bg-black text-white py-2 px-4 rounded hover:bg-black">
                                        Save Category
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>


                </div>
            </main>
        </div>

        <script>
            // Mobile menu toggle
            const mobileMenuButton = document.querySelector('.mobile-menu-button');
            const mobileMenu = document.querySelector('.mobile-menu');

            mobileMenuButton.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
                    mobileMenu.classList.add('hidden');
                }
            });
        </script>
    </body>

    <%- include('./partials/footer'); %>