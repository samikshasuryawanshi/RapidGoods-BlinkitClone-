<%- include('./partials/header'); %>

    <body class="bg-gray-100 font-sans">
        <div class="max-w-md mx-auto p-4">
            <!-- Header -->
            <div class="flex justify-between items-center py-4 sticky top-0 bg-gray-100 z-10">
                <a href="/products" class="text-lg hover:text-blue-600 transition-colors"><i class="ri-arrow-left-s-line"></i></a>
                <h1 class="text-xl font-semibold text-gray-800">Checkout</h1>
                <button class="text-lg hover:text-blue-600 transition-colors"><i class="ri-share-line"></i></button>
            </div>

            <!-- Delivery Info -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-4 transform hover:shadow-md transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 flex items-center justify-center rounded-full bg-blue-50 text-blue-600">
                        <i class="ri-timer-line text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-800">Delivery in <%= Math.floor((Math.random()*10)+3) %> minutes</p>
                        <p class="text-xs text-gray-500">Shipment of <%= cart.length %> item<%= cart.length > 1 ? 's' : '' %></p>
                    </div>
                </div>
                <% cart.forEach(elem=> { %>
                    <div class="flex items-center mt-4 p-3 rounded-lg hover:bg-gray-50 transition-colors">
                        <img src="data:image/jpg;base64, <%= elem.image.toString('base64') %>" alt="<%= elem.name %>"
                            class="w-16 h-16 rounded-lg object-cover">
                        <div class="ml-4 flex-1">
                            <p class="font-medium text-gray-800">
                                <%= elem.name %>
                            </p>
                            <p class="text-xs text-gray-500">170 g</p>
                        </div>
                        <div class="ml-auto">
                            <div class="flex items-center justify-center bg-green-700 text-white rounded-lg overflow-hidden">
                                <a href="/cart/remove/<%= elem._id %>" class="px-3 py-1.5 hover:bg-green-800 transition-colors">
                                    <i class="ri-subtract-line"></i>
                                </a>
                                <p class="mx-3 font-medium">
                                    <%= elem.quantity %>
                                </p>
                                <button class="px-3 py-1.5 hover:bg-green-800 transition-colors">
                                    <i class="ri-add-line"></i>
                                </button>
                            </div>
                            <div class="flex gap-2 mt-3">
                                <p class="text-sm text-gray-400 line-through">₹<%= Number(elem.price)*Number(elem.quantity)+20 %></p>
                                <p class="text-sm font-medium text-gray-800">₹<%= Number(elem.price)*Number(elem.quantity) %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Before You Checkout -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-4 transform hover:shadow-md transition-all duration-300">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Before you checkout</h2>
                <div class="flex space-x-4 overflow-x-auto pb-4">
                    <div class="flex flex-col items-center min-w-[120px]">
                        <img src="https://www.bigbasket.com/media/uploads/p/xxl/40015993_11-uncle-chips-spicy-treat.jpg"
                            alt="Product Image" class="h-24 w-24 object-cover rounded-lg">
                        <p class="text-sm text-center mt-2 text-gray-800">Uncle Chipps Spicy Treat</p>
                        <p class="text-xs text-gray-500">48 g</p>
                        <button class="bg-green-700 text-white px-4 py-1 rounded-lg mt-2 hover:bg-green-800 transition-colors">ADD</button>
                        <p class="text-xs mt-2 text-gray-800">₹20</p>
                    </div>
                    <div class="flex flex-col items-center min-w-[120px]">
                        <img src="https://m.media-amazon.com/images/I/61mQ-Q7HmCL._AC_UF1000,1000_QL80_.jpg"
                            alt="Product Image" class="h-24 w-24 object-cover rounded-lg">
                        <p class="text-sm text-center mt-2 text-gray-800">Coca-Cola Soft Drink</p>
                        <p class="text-xs text-gray-500">300 ml</p>
                        <button class="bg-green-700 text-white px-4 py-1 rounded-lg mt-2 hover:bg-green-800 transition-colors">ADD</button>
                        <p class="text-xs mt-2 text-gray-800">₹40</p>
                    </div>
                    <div class="flex flex-col items-center min-w-[120px]">
                        <img src="https://www.dorita.se/media/catalog/product/9/0/900179-lay-s-saltet-potetgull-175g.jpg"
                            alt="Product Image" class="h-24 w-24 object-cover rounded-lg">
                        <p class="text-sm text-center mt-2 text-gray-800">Chheda's Golden Banana Chips</p>
                        <p class="text-xs text-gray-500">170 g</p>
                        <button class="bg-green-700 text-white px-4 py-1 rounded-lg mt-2 hover:bg-green-800 transition-colors">ADD</button>
                        <p class="text-xs mt-2 text-gray-800">₹85</p>
                        <p class="text-xs text-red-500">16% OFF</p>
                    </div>
                </div>
                <div class="mt-4 text-center bg-gradient-to-r from-green-600 to-green-700 py-6 px-10 rounded-xl">
                    <h1 class="text-xl font-semibold text-white">Get FREE delivery</h1>
                    <p class="text-sm text-green-100 mt-1">Add products worth ₹236 more</p>
                    <button class="text-sm bg-white text-green-700 px-8 py-2 rounded-lg font-semibold capitalize mt-4 hover:bg-green-50 transition-colors">
                        See all coupons
                    </button>
                </div>
            </div>

            <!-- Bill Details -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-4 transform hover:shadow-md transition-all duration-300">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Bill details</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <p class="text-sm text-gray-600">Items total</p>
                        <p class="text-sm text-gray-800">₹ <%= finalPrice - 34 %></p>
                    </div>
                    <div class="flex justify-between">
                        <p class="text-sm text-gray-600">Delivery charge</p>
                        <p class="text-sm text-gray-800">₹30</p>
                    </div>
                    <div class="flex justify-between">
                        <p class="text-sm text-gray-600">Handling charge</p>
                        <p class="text-sm text-gray-800">₹4</p>
                    </div>
                    <div class="border-t border-gray-100 pt-3 mt-2">
                        <div class="flex justify-between">
                            <p class="text-lg font-bold text-gray-800">Grand total</p>
                            <p class="text-lg font-bold text-gray-800">₹<%=finalPrice%></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donation -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-4 transform hover:shadow-md transition-all duration-300">
                <div class="flex items-center">
                    <img src="https://b.zmtcdn.com/data/fi_assets/9fbf0569f69bfef7d190c5b892ab0a521619355737.png"
                        alt="Feeding India" class="w-12 h-12 rounded-lg">
                    <div class="ml-4 flex-1">
                        <p class="font-semibold text-gray-800">Feeding India donation</p>
                        <p class="text-sm text-gray-500">Working towards a malnutrition free India. Feeding India...
                            <span class="text-blue-600 hover:text-blue-700 transition-colors">read more</span>
                        </p>
                    </div>
                    <p class="ml-auto text-sm font-bold text-gray-800">₹1</p>
                </div>
            </div>

            <!-- Delivery Instructions -->
            <div class="bg-white p-4 rounded-xl shadow-sm transform hover:shadow-md transition-all duration-300">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Delivery instructions</h2>
                <div class="grid grid-cols-4 gap-4">
                    <button class="flex flex-col items-center justify-center py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <i class="ri-mic-line text-xl text-gray-600"></i>
                        <p class="text-xs text-gray-600 mt-1">Record</p>
                    </button>
                    <button class="flex flex-col items-center justify-center py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <i class="ri-prohibited-line text-xl text-gray-600"></i>
                        <p class="text-xs text-gray-600 mt-1">Avoid calling</p>
                    </button>
                    <button class="flex flex-col items-center justify-center py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <i class="ri-notification-off-line text-xl text-gray-600"></i>
                        <p class="text-xs text-gray-600 mt-1">Don't ring bell</p>
                    </button>
                    <button class="flex flex-col items-center justify-center py-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <i class="ri-door-open-line text-xl text-gray-600"></i>
                        <p class="text-xs text-gray-600 mt-1">Leave at door</p>
                    </button>
                </div>
            </div>

            <!-- Ordering for someone else -->
            <div class="bg-white p-4 rounded-xl shadow-sm mt-6 text-gray-800 hover:shadow-md transition-all duration-300">
                <div class="flex items-center justify-between">
                    <span>Ordering for someone else?</span>
                    <button class="text-blue-600 hover:text-blue-700 transition-colors">Add details</button>
                </div>
            </div>

            <!-- Cancellation Policy -->
            <div class="bg-white p-4 rounded-xl shadow-sm mb-40 mt-6 text-sm text-gray-600 hover:shadow-md transition-all duration-300">
                <p>
                    Orders cannot be cancelled once packed for delivery. In case of unexpected delays, a refund will be
                    provided, if applicable.
                </p>
            </div>

            <!-- Footer -->
            <div class="bg-white p-4 rounded-xl shadow-lg fixed bottom-0 inset-x-0 max-w-md mx-auto">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-sm font-medium text-gray-800">Delivering to Home</p>
                        <p class="text-xs text-gray-500">1st Floor M2, 132C Apex Builders Sector C Indrauri, saarthi...</p>
                    </div>
                    <button class="text-blue-600 hover:text-blue-700 transition-colors">Change</button>
                </div>
                <div class="flex justify-between items-center mt-3">
                    <div>
                        <p class="text-sm font-medium text-gray-800">PAY USING</p>
                        <p class="text-xs text-gray-500">Paytm UPI</p>
                    </div>
                    <div class="text-right">
                        <p class="text-lg font-bold text-gray-800">₹<%= finalPrice %></p>
                        <button class="paybtn bg-green-700 text-white px-6 py-2 rounded-lg hover:bg-green-800 transition-colors">Place Order</button>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script>
            document.querySelector('.paybtn').onclick = function (e) {
                axios.post('/payment/create/orderId')
                    .then(function (response) {
                        var options = {
                            "key": "rzp_test_mPrfMJIy2Vcxb5", // Enter the Key ID generated from the Dashboard
                            "amount": response.data.amount, // Amount in currency subunits. Default currency is INR.
                            "currency": response.data.currency,
                            "name": "RapidGoods",
                            "description": "Test Transaction",
                            "image": "https://example.com/your_logo",
                            "order_id": response.data.id,
                            "handler": function (response) {
                                axios.post('/payment/api/payment/verify', {
                                    razorpayOrderId: response.razorpay_order_id,
                                    razorpayPaymentId: response.razorpay_payment_id,
                                    signature: response.razorpay_signature
                                })
                                    .then(function (response) {
                                        let { razorpayOrderId, razorpayPaymentId, signature } = JSON.parse(response.config.data)
                                        window.location.href = `/order/<%= userid %>/${razorpayOrderId}/${razorpayPaymentId}/${signature}`
                                    })
                                    .catch(function (error) {
                                        console.error(error);
                                    });
                            },
                            "prefill": {
                                "name": "samii",
                                "email": "samii@example.com",
                                "contact": "9000090000"
                            },
                            "notes": {
                                "address": "Razorpay Corporate Office"
                            },
                            "theme": {
                                "color": "#3399cc"
                            }
                        };
                        var rzp1 = new Razorpay(options);
                        rzp1.on('payment.failed', function (response) {
                            alert('Payment Failed');
                            alert('Error Code: ' + response.error.code);
                            alert('Description: ' + response.error.description);
                            alert('Source: ' + response.error.source);
                            alert('Step: ' + response.error.step);
                            alert('Reason: ' + response.error.reason);
                            alert('Order ID: ' + response.error.metadata.order_id);
                            alert('Payment ID: ' + response.error.metadata.payment_id);
                        });
                        rzp1.open();
                        e.preventDefault();
                    })
                    .catch(function (error) {
                        console.error(error);
                    });
            };
        </script>
    </body>

    <%- include('./partials/footer'); %>
    <%- include('./partials/footer'); %>